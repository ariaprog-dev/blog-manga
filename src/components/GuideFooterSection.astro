---
import { getCollection } from 'astro:content';
import FormattedDate from './FormattedDate.astro';
import { filterPostsForGuide, GUIDE_PAGES, type GuideId } from '../data/guides';

interface Props {
	currentGuideId: GuideId;
	sectionTitle?: string;
}

const { currentGuideId, sectionTitle = 'あわせて読みたい関連レビュー・特集記事' } = Astro.props;

const allPosts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const matchedPosts = filterPostsForGuide(currentGuideId, allPosts, 6);
const siblingGuides = GUIDE_PAGES.filter((g) => g.id !== currentGuideId);
---

<section class="guide-footer-section" aria-label={sectionTitle}>
	{matchedPosts.length > 0 && (
		<>
			<h2 class="guide-footer-heading">{sectionTitle}</h2>
			<p class="guide-footer-sub">
				ここで押さえたポイントを踏まえ、出版仕様や作風を詳しく整理した個別レビュー・比較記事もあわせてご覧ください。
			</p>
			<div class="guide-related-grid">
				{matchedPosts.map((post) => (
					<a href={`/blog/${post.id}/`} class="guide-related-card">
						<div class="guide-related-thumb">
							{post.data.heroImage ? (
								<img src={post.data.heroImage} alt={post.data.title} loading="lazy" />
							) : (
								<span>RECOMMEND</span>
							)}
						</div>
						<div class="guide-related-body">
							<span class="guide-related-date">
								<FormattedDate date={post.data.pubDate} />
							</span>
							<h3 class="guide-related-title">{post.data.title}</h3>
						</div>
					</a>
				))}
			</div>
		</>
	)}

	<div class="guide-sibling-box">
		<h2 class="guide-footer-heading" style="font-size: 1.05rem; margin-bottom: 0.25rem;">
			ほかの基礎知識テーマも読む
		</h2>
		<p class="guide-footer-sub" style="margin-bottom: 0;">
			作品選びから版型の見極め、紙・電子の使い分け、映像ソフト・立体物まで一通りチェックできます（<a href="/guide/">基礎知識トップへ戻る</a>）。
		</p>
		<div class="guide-sibling-grid">
			{siblingGuides.map((g) => (
				<a href={g.href} class="guide-sibling-card">
					<span class="guide-sibling-label">{g.icon} {g.badge}</span>
					<h3 class="guide-sibling-title">{g.title}</h3>
				</a>
			))}
		</div>
	</div>
</section>
